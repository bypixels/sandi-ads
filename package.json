{
  "name": "seo-mcp-pro",
  "version": "0.1.0",
  "description": "MCP server for website operations - Google Marketing, SEO, Performance, Security & Monitoring. 121 tools for Claude.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seo-mcp-pro": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bypixels/SEO-MCP-PRO.git"
  },
  "homepage": "https://github.com/bypixels/SEO-MCP-PRO#readme",
  "bugs": {
    "url": "https://github.com/bypixels/SEO-MCP-PRO/issues"
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/ui dist/drizzle && cp src/dashboard/ui/index.html dist/ui/index.html && cp drizzle/*.sql dist/drizzle/",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker exec -it website-ops-pg psql -U website_ops -d website_ops",
    "start": "node dist/index.js",
    "dashboard": "DASHBOARD_ENABLED=true node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "dashboard:key": "node --input-type=module -e \"import 'dotenv/config'; import {readFileSync} from 'node:fs'; import {join} from 'node:path'; console.log(process.env.DASHBOARD_API_KEY || readFileSync(join(process.env.CREDENTIAL_STORE_PATH || process.cwd(), '.website-ops-dashboard.key'), 'utf8').trim())\""
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "seo",
    "google-analytics",
    "google-tag-manager",
    "search-console",
    "google-ads",
    "pagespeed",
    "core-web-vitals",
    "lighthouse",
    "website-monitoring",
    "security-audit",
    "accessibility",
    "cloudflare",
    "ai-tools"
  ],
  "author": "bypixels",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.7",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "google-ads-api": "^17.0.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^140.0.0",
    "pg": "^8.20.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.11.0",
    "globals": "^17.2.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
